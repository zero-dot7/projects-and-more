{
  "manifest_version": 3,
  "name": "Group Speed Dial",
  "version": "0.3.16",
  "description": "New tab page with grouped speed-dial tiles. Local only, no accounts, no tracking.",
  "permissions": ["storage", "favicon", "unlimitedStorage", "tabs", "activeTab", "identity"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "quick-add-tile": {
      "suggested_key": { "default": "Ctrl+Q" },
      "description": "Quick add current page to Speed Dial"
    }
  },
  "host_permissions": [
    "https://content.dropboxapi.com/*",
    "https://api.dropboxapi.com/oauth2/token",
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
