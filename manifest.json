{
  "manifest_version": 3,
  "name": "Group Speed Dial",
  "version": "0.2.13",
  "description": "New tab page with grouped speed-dial tiles. Local only, no accounts, no tracking.",
  "permissions": ["storage", "favicon", "unlimitedStorage", "topSites", "tabs", "activeTab"],
  "host_permissions": [
    "https://content.dropboxapi.com/*",
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
